# ==========================================
# Ayan AI - Frontend Environment Configuration
# ==========================================

# Backend API URL
# For local development: http://localhost:5000
# For production on Vercel: Set to your deployed Render backend URL (e.g. https://your-backend.onrender.com)
VITE_API_URL=http://localhost:5000

# NOTE FOR PRODUCTION DEPLOYMENT:
# Never add GEMINI_API_KEY, MONGODB_URI, or JWT_SECRET here.
# All backend secrets are securely configured on Render in server environment variables.
